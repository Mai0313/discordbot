# Using OpenAI Endpoint
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...

# Google AI Studio key for the direct-to-Google paths (Veo video generation, Gemini Files
# API uploads, deep research). Not routed through the proxy.
#
# This must be the same credential the proxy's conversational deployments hold: an uploaded
# file is readable only by the project that uploaded it, so a reply that uploads here and is
# answered from another key fails outright. The proxy may still pool its other keys across
# the aliases that never carry a Files uri (media generation, TTS, music, embeddings); that
# is its own config's business and needs nothing here.
GEMINI_API_KEY=AIza...

# Discord Bot Token
DISCORD_BOT_TOKEN=MTEz...

# Best-effort media kill-switches (default true). When false the answer model's marker is
# still stripped from the reply but no clip / image is produced.
INLINE_VOICE_ENABLED=true
INLINE_IMAGE_ENABLED=true
# When false the QA `<music>` marker is stripped but no music clip is generated (Lyria).
INLINE_MUSIC_ENABLED=true
# When false the QA `<video>` marker is stripped but no video clip is generated (omni).
INLINE_VIDEO_ENABLED=true
# When false a linked YouTube video is not watched (the QA turn falls back to the text path).
YOUTUBE_VIDEO_ENABLED=true
# When false the QA `<deep-research>` marker is stripped but no research thread is launched, and
# a restart does not re-attach to one that was already running.
DEEP_RESEARCH_ENABLED=true
# When false the IMAGE-route request is sent to the image model as-is, with no prompt director
# refining it first (the inline `<generate-image>` marker never refines either way).
IMAGE_REFINE_PROMPT_ENABLED=true
# When false the VIDEO-route request is sent to the video model as-is, with no prompt director
# refining it first (the inline `<generate-video>` marker never refines either way).
VIDEO_REFINE_PROMPT_ENABLED=true
# When false no media reaches the answer model as a Files API reference: Discord attachments
# inline as base64 instead (images, PDFs and text survive; video and audio are dropped) and
# linked-post media is not uploaded at all, leaving those posts as text. The lever for a
# provider-side outage where the upload succeeds but the model is then refused the file,
# which costs the whole reply rather than just the attachment.
FILE_API_ENABLED=true

# When false a Douyin link pasted in chat is no longer expanded into the channel. Auto-expansion
# turns every pasted link into a request, and Douyin's WAF bans a share path for tens of minutes
# under load, so this is the one lever that stops the bot talking to Douyin during an incident.
DOUYIN_AUTO_EXPAND_ENABLED=true
# When false a mentioned Douyin link still supplies its caption as context, but the clip is not
# downloaded or uploaded, and the model is told plainly that it has not seen the footage.
DOUYIN_VIDEO_ENABLED=true
# When false a mentioned Bilibili link still supplies the video's title and description as
# context, but the clip is not downloaded or uploaded, and the model is told plainly that it
# has not watched it.
BILIBILI_VIDEO_ENABLED=true

# External static media host: when a clip/file exceeds Discord's per-message upload limit
# (e.g. a long voice WAV in a DM, which has only a 20 MiB ceiling), the bot writes it under
# MEDIA_HOSTING_SERVE_DIR and posts MEDIA_HOSTING_BASE_URL/<name> instead of dropping it. The
# serve dir is bind-mounted from the host; nginx serves it with a strict extension allowlist.
# The bot never creates the serve dir: if it is absent it logs and falls back to native upload.
# Leave base_url / serve_dir empty to disable the fallback (media degrades exactly as before).
# Hosted files are content-addressed (identical content is stored once) and self-cleaned: the serve
# dir is bounded by both MEDIA_HOSTING_MAX_BYTES (oldest evicted past it; 8 GiB stays under R2's
# 10 GB free tier) and MEDIA_HOSTING_RETENTION_HOURS (older files reaped, cap or not). Either <=0
# disables that cap. The reaper only ever deletes the bot's own files, never anything else in the dir.
MEDIA_HOSTING_ENABLED=true
MEDIA_HOSTING_BASE_URL=https://media.mai0313.com
MEDIA_HOSTING_SERVE_DIR=/mnt/share/media
MEDIA_HOSTING_MAX_BYTES=8589934592
MEDIA_HOSTING_RETENTION_HOURS=168

# Long-term memory keeps its own git history under ./data/memories so a bad consolidation can
# be read back and compared. The bot never creates that repository: run `git init` there once
# and it starts committing, leave it absent and this does nothing. Note that a `/memory clear`
# removes the files but not the earlier commits holding them, so local history outlives a clear.
MEMORY_GIT_ENABLED=true

# `/feedback` turns a user's report into an issue on the repository below, and reads the
# maintainer's replies back into their panel. Two ways to authenticate, and the difference is
# visible on every issue: a GitHub App files them as `<app>[bot]`, which is what they are, while
# a personal token files them as you — and GitHub never notifies you about your own actions, so
# you would not hear about a new report at all. Prefer the app; it also rotates its own token.
#
# The app needs one permission, Issues: Read and write, and nothing else. Give it more and the
# PEM on disk becomes a key to the whole repository instead of to its issue tracker.
# FEEDBACK_GITHUB_APP_ID takes either the App ID or the Client ID (GitHub recommends the latter);
# both are just the issuer of the JWT that buys an hour-long installation token. The private key
# is a path rather than the key itself, because a PEM is multi-line and escaping it here is a
# trap; inside the container that path is under the ./data -> /app/data bind mount.
#
# Without credentials the command still takes reports, stores them, and still has the model tidy
# them up; they queue with no ticket number and the retry sweep opens all of them, already
# written up, on its first pass after the credentials land. FEEDBACK_ENABLED=false is the actual
# off switch, and that is the only case that shows FEEDBACK_CONTACT instead of the panel.
#
# The names carry the FEEDBACK_ prefix on purpose: GitHub Actions exports GITHUB_REPOSITORY and
# `gh` users often export GITHUB_TOKEN, and an already-exported variable wins over this file.
FEEDBACK_ENABLED=true
FEEDBACK_GITHUB_APP_ID=Iv23li...
FEEDBACK_GITHUB_APP_PRIVATE_KEY_PATH=/app/data/feedback-app.pem
FEEDBACK_GITHUB_REPOSITORY=Mai0313/discordbot
FEEDBACK_CONTACT=mai9999
# An account token instead of an app, for a setup that does not want to create one. Ignored when
# the app above is configured.
# FEEDBACK_GITHUB_TOKEN=github_pat_...
# One person may hold this many unresolved reports, and must wait this long between two of
# them. Anyone sharing a server with the bot can open an issue on your repository, and GitHub
# has nothing on its side to stop them.
FEEDBACK_MAX_OPEN_REPORTS=3
FEEDBACK_SUBMIT_COOLDOWN_SECONDS=300

# Lowest severity written to the console and to ./data/logs. `debug` keeps the full trace a
# debugging session needs; raise it to `info` on a deployment that only wants outcomes.
LOG_LEVEL=debug

# One JSON line per slash-command invocation and per AI reply, in ./data/usage/<YYYY-MM>.jsonl,
# so an occasional stocktake can find the features nobody uses. Deliberately outside ./data/logs:
# that file is debug-level, hand-cleaned and gated on LOG_LEVEL, so a usage history kept there
# would die with it or silently stop. Records hold numeric ids only, never names or content, and
# nothing prunes them. Set false to record nothing at all.
USAGE_LOG_ENABLED=true
USAGE_LOG_DIR=./data/usage
