# Using OpenAI Endpoint
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...

# Google AI Studio key for the direct-to-Google paths (Gemini Files API uploads, YouTube
# watching, omni video, Lyria music, deep research). Not routed through the proxy.
#
# This must be the same credential the proxy's conversational deployments hold: an uploaded
# file is readable only by the project that uploaded it, so a reply that uploads here and is
# answered from another key fails outright. The proxy may still pool its other keys across
# the aliases that never carry a Files uri (media generation, TTS, music, embeddings); that
# is its own config's business and needs nothing here.
GEMINI_API_KEY=AIza...

# Direct Anthropic / xAI Files API upload keys, for uploaders that are scaffolded but not
# enabled yet.
# ANTHROPIC_API_KEY=sk-ant-...
# XAI_API_KEY=xai-...

# Discord Bot Token and Presence Activity
DISCORD_BOT_TOKEN=MTEz...
# DISCORD_BOT_ACTIVITY=Discord

# Reaction and status emojis (default to standard Unicode; override with custom `<:name:id>` app emojis).
# EMOJI_FACEBOOK=📘
# EMOJI_INSTAGRAM=📷
# EMOJI_THREADS=🧵
# EMOJI_TWITTER=🐦
# EMOJI_DOUYIN=🎵
# EMOJI_BILIBILI=📺
# EMOJI_DONE=✅
# EMOJI_FAILED=❌
# EMOJI_ROUTING=🔀
# EMOJI_IMAGE=🖼️
# EMOJI_VIDEO=🎬
# EMOJI_ANSWER=💬
# EMOJI_VOICE=🗣️
# EMOJI_YOUTUBE=▶️
# EMOJI_RESEARCH=🔬

# When false finalized replies omit the 👍/👎 feedback buttons (and the `🔄` regenerate button on
# gateway QA replies), skip recording turn snapshots in `reply.db`, and refuse `🔄` regeneration
# clicks (👍/👎 buttons on older replies still remain active).
FEEDBACK_ENABLED=true
# When true QA turns randomly draw `slow_model` from the blind-test candidate pool (allowing `🔄`
# regeneration up to `len(candidates) - 1` times across remaining untried candidates) and mask the
# model name as `blind-test-model` in the system prompt and reply footer (also hiding the effort
# label in the footer), while keeping the real answered model and effort in `reply.db` and logs;
# when false QA uses `slow_model`, allows one regeneration, and shows its real name and effort.
SLOW_MODEL_BLIND_TEST_ENABLED=false
# When false no media reaches the answer model as a Files API reference: Discord attachments
# inline as base64 instead (images, PDFs and text survive unless too large to inline; video and
# audio are dropped) and linked-post media is not uploaded at all, leaving those posts as text.
# The lever for a provider-side outage where the upload succeeds but the model is then refused
# the file, which costs the whole reply rather than just the attachment.
FILE_API_ENABLED=true
# When false QA answers and media-persona follow-ups fetch complete non-streaming responses and
# post them once finished without live preview edits.
ANSWER_STREAMING_ENABLED=true

# External static media host: when a clip/file exceeds Discord's per-message upload limit
# (e.g. a long voice WAV in a DM, which has only a 20 MiB ceiling), the bot writes it under
# MEDIA_HOSTING_SERVE_DIR and posts MEDIA_HOSTING_BASE_URL/<name> instead of dropping it. The
# serve dir is bind-mounted from the host; nginx serves it with a strict extension allowlist.
# The bot never creates the serve dir: if it is absent it logs and media degrades as with hosting off.
# Leave base_url / serve_dir empty to disable the fallback (media degrades exactly as before).
# Hosted files are content-addressed (identical content is stored once) and self-cleaned: the serve
# dir is bounded by both MEDIA_HOSTING_MAX_BYTES (oldest evicted past it; 8 GiB stays under R2's
# 10 GB free tier) and MEDIA_HOSTING_RETENTION_HOURS (older files reaped, cap or not). Either <=0
# disables that cap. The reaper only ever deletes the bot's own files, never anything else in the dir.
MEDIA_HOSTING_ENABLED=true
MEDIA_HOSTING_BASE_URL=
MEDIA_HOSTING_SERVE_DIR=
MEDIA_HOSTING_MAX_BYTES=8589934592
MEDIA_HOSTING_RETENTION_HOURS=168

# Long-term memory keeps its own git history under ./data/memories so a bad consolidation can
# be read back and compared. The bot never creates that repository: run `git init` there once
# and it starts committing, leave it absent and this does nothing. Note that a `/memory clear`
# removes the files but not the earlier commits holding them, so local history outlives a clear.
MEMORY_GIT_ENABLED=true

# Lets a central-bank borrower approve their own loan, for local testing only. Keep it unset
# or false in production.
# ECONOMY_ALLOW_CENTRAL_BANK_SELF_APPROVAL=false

# Lowest severity written to the console and to ./data/logs. `debug` keeps the full trace a
# debugging session needs; raise it to `info` on a deployment that only wants outcomes.
LOG_LEVEL=debug

# One JSON line per slash-command invocation and per AI reply, in ./data/usage/<YYYY-MM>.jsonl,
# so an occasional stocktake can find the features nobody uses. Deliberately outside ./data/logs:
# that file is debug-level, hand-cleaned and gated on LOG_LEVEL, so a usage history kept there
# would die with it or silently stop. Records hold numeric ids plus the username as a label, never
# content, and nothing prunes them. Set false to record nothing at all.
USAGE_LOG_ENABLED=true
USAGE_LOG_DIR=./data/usage
